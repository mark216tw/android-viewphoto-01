<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_photo_content_description_default"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:paddingBottom="56dp"
        android:text="@string/widget_loading"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/widget_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:paddingHorizontal="4dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/widget_control_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_control_bar"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_previous"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_previous"
                android:tint="@color/widget_control_tint" />

            <ImageButton
                android:id="@+id/widget_refresh"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_refresh"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_refresh"
                android:tint="@color/widget_control_tint" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_next"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_next"
                android:tint="@color/widget_control_tint" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
